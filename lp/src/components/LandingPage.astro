---
import Base from '../layouts/Base.astro';
import LandingFooter from './LandingFooter';
import LandingHeader from './LandingHeader';
import LandingFeatures from './LandingFeatures';
import LandingAudience from './LandingAudience';
import LandingStack from './LandingStack';
import LandingHero from './LandingHero';
import LandingFaq from './LandingFaq';
import type { LandingCopy } from '../lib/lpContent';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${new URL(copy.canonicalPath, Astro.site)}#faq`,
  inLanguage: copy.lang,
  mainEntity: copy.faq.items.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Base
  title={copy.title}
  description={copy.description}
  ogDescription={copy.ogDescription}
  lang={copy.lang}
  canonicalPath={copy.canonicalPath}
>
  <LandingHeader copy={copy} />

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-5xl px-6 pt-24 pb-16 text-center">
      <LandingHero copy={copy.hero} />

      <!-- Screenshot carousel -->
      <div class="mx-auto">
        <div class="relative overflow-hidden rounded-xl shadow-2xl shadow-[var(--color-accent)]/5">
          <div id="carousel-track" class="flex" style="transition: transform 0.45s cubic-bezier(.4,0,.2,1)">
            <img
              src="/Whichcraft/screenshot-tools.png"
              alt={copy.screenshots.toolsAlt}
              width="1200"
              height="800"
              class="w-full shrink-0"
              loading="eager"
            />
            <img
              src="/Whichcraft/screenshot-plan.png"
              alt={copy.screenshots.planAlt}
              width="1200"
              height="800"
              class="w-full shrink-0"
              loading="lazy"
            />
            <img
              src="/Whichcraft/screenshot-profiles.png"
              alt={copy.screenshots.profilesAlt}
              width="1200"
              height="800"
              class="w-full shrink-0"
              loading="lazy"
            />
          </div>
          <button
            id="carousel-prev"
            aria-label={copy.screenshots.prevLabel}
            class="absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-surface)]/80 border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)]/60 transition-colors backdrop-blur"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button
            id="carousel-next"
            aria-label={copy.screenshots.nextLabel}
            class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-surface)]/80 border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)]/60 transition-colors backdrop-blur"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
        <!-- Dots -->
        <div class="flex justify-center gap-2 mt-4">
          <button id="dot-0" aria-label={copy.screenshots.firstLabel} class="w-2 h-2 rounded-full transition-colors" style="background:var(--color-accent)"></button>
          <button id="dot-1" aria-label={copy.screenshots.secondLabel} class="w-2 h-2 rounded-full transition-colors" style="background:var(--color-muted);opacity:0.4"></button>
          <button id="dot-2" aria-label={copy.screenshots.thirdLabel} class="w-2 h-2 rounded-full transition-colors" style="background:var(--color-muted);opacity:0.4"></button>
        </div>
      </div>
      <script>
        {
          const track = document.getElementById('carousel-track');
          const dots = [document.getElementById('dot-0'), document.getElementById('dot-1'), document.getElementById('dot-2')];
          const prevBtn = document.getElementById('carousel-prev');
          const nextBtn = document.getElementById('carousel-next');
          let current = 0;
          let timer: ReturnType<typeof setInterval>;

          function goTo(i: number) {
            current = i;
            (track as HTMLElement).style.transform = `translateX(-${i * 100}%)`;
            dots.forEach((d, j) => {
              (d as HTMLElement).style.background = j === i ? 'var(--color-accent)' : 'var(--color-muted)';
              (d as HTMLElement).style.opacity = j === i ? '1' : '0.4';
            });
          }

          function startAuto() {
            timer = setInterval(() => goTo((current + 1) % dots.length), 5000);
          }

          function restart(i: number) {
            clearInterval(timer);
            goTo(i);
            startAuto();
          }

          dots.forEach((d, i) => d?.addEventListener('click', () => restart(i)));
          prevBtn?.addEventListener('click', () => restart((current - 1 + dots.length) % dots.length));
          nextBtn?.addEventListener('click', () => restart((current + 1) % dots.length));

          const SWIPE_THRESHOLD_PX = 40;
          let touchStartX = 0;

          track?.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].clientX;
          }, { passive: true });

          track?.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(dx) < SWIPE_THRESHOLD_PX) return;
            if (dx < 0) restart((current + 1) % dots.length);
            else restart((current - 1 + dots.length) % dots.length);
          }, { passive: true });

          startAuto();
        }
      </script>
    </section>

    <LandingFeatures copy={copy} />
    <LandingAudience copy={copy.audience} />
    <LandingFaq copy={copy.faq} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
    <LandingStack copy={copy.stack} />
  </main>

  <LandingFooter copy={copy} />

  <script>
    const track = (id: string, event: string) => {
      document.getElementById(id)?.addEventListener('click', () => {
        window.gtag?.('event', event);
      });
    };
    track('nav-download', 'download_click');
    track('hero-download', 'download_click');
    track('nav-github', 'github_link_click');
    track('hero-github', 'github_link_click');
    track('footer-github', 'github_link_click');

    document.getElementById('lang-select')?.addEventListener('change', (e) => {
      const path = (e.target as HTMLSelectElement).value;
      if (path) window.location.href = path;
    });
  </script>
</Base>
